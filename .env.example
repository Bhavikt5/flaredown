# Copy this file to .env and fill in your own free keys. Never share .env.

# Google AI Studio -> Get API key (free tier). Used only for "Snap a meal".
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: change the model if the default stops working.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase -> Project Settings -> API (Project URL and Publishable key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
