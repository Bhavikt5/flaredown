{
  "expo": {
    "name": "Flare Down",
    "slug": "flare-down",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.flaredown.prototype"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Flare Down uses the camera to photograph your skin and meals. Photos stay on your phone."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flare Down uses your approximate location to log daily weather and humidity."
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Flare Down uses the camera to scan food barcodes and photograph meals and skin. Photos stay on your phone."
        }
      ]
    ],
    "scheme": "flaredown"
  }
}
